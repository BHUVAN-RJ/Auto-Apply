OPENROUTER_API_KEY=
# Cheaper alternatives: z-ai/glm-5.3-flash, deepseek/deepseek-v4-pro
OPENROUTER_TAILOR_MODEL=z-ai/glm-5.3
# The browser model must accept images and be reliable at tool schemas:
# browser-use sends a screenshot every step, and a model that mis-formats an
# action fails validation on every one of them.
# Stronger if fills go wrong: google/gemini-3.8-flash
OPENROUTER_BROWSER_MODEL=google/gemini-3.1-flash-lite
