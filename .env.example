OPENROUTER_API_KEY=
# Cheaper alternatives: z-ai/glm-5.3-flash, deepseek/deepseek-v4-pro
OPENROUTER_TAILOR_MODEL=z-ai/glm-5.3
# Free-form form answers (review page "Ask for an answer"); the tailor model when unset
# OPENROUTER_ANSWER_MODEL=z-ai/glm-5.3
# The browser model must accept images and be reliable at tool schemas:
# browser-use sends a screenshot every step, and a model that mis-formats an
# action fails validation on every one of them.
# Not DeepSeek: browser-use forces use_vision=False for any DeepSeek model,
# whatever OpenRouter says about images, so the agent runs blind.
# Stronger if fills go wrong: google/gemini-3.8-flash
OPENROUTER_BROWSER_MODEL=google/gemini-3.1-flash-lite
# The on-page screen is a small classification and runs the moment a job
# page opens, so it wants the fastest cheap model available.
OPENROUTER_SCREEN_MODEL=deepseek/deepseek-v4-flash
# Local origin used by browser.inject. Leave at 8787 unless that port belongs
# to another service; uvicorn must be started on the same port.
# AUTOPILOT_SERVER_URL=http://127.0.0.1:8787
# Pin Google Chrome when another Chromium browser is installed.
# AUTOPILOT_BROWSER=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# The profile interviewer runs every turn on this model; it defaults to the
# screen model. Compared on the real resume (PLAN.md, Phase 7 status):
# GLM 5.3 Flash judges coverage more strictly and counts years correctly,
# DeepSeek Flash answers in 1-3 s instead of 3-5 s. GLM requires reasoning
# on; the code sends the lowest effort it allows.
OPENROUTER_INTERVIEW_MODEL=z-ai/glm-5.3-flash
# Speech in is whisper.cpp (`brew install whisper-cpp`; the model downloads
# from the page). Speech out is Kokoro when `pip install .[voice]` and
# `brew install espeak-ng` are done (the model downloads from the page);
# the macOS system voice otherwise. Voices: af_heart, af_bella, am_michael,
# bf_emma, ... (kokoro-onnx voices-v1.0).
# Hosted speech out, used ahead of the local voices when the key is set.
# Key from https://fish.audio/app/developers/ . s2.1-pro-free costs nothing
# under fair use (through Nov 2026); s1 and s2-pro are paid. The voice is
# a fish.audio library voice id (the id in the voice's URL); blank means
# EnglishSarah. Without one the API picks a new voice every sentence.
# AUTOPILOT_FISH_API_KEY=
# AUTOPILOT_FISH_MODEL=s2.1-pro-free
# AUTOPILOT_FISH_VOICE=
# Delivery: an emotion tag (cheerful, excited, calm, ...; blank for none),
# sampling temperature 0-1, speed 0.5-2.0.
# AUTOPILOT_FISH_EMOTION=cheerful
# AUTOPILOT_FISH_TEMPERATURE=0.9
# AUTOPILOT_FISH_SPEED=1.08
# AUTOPILOT_WHISPER_BIN=
# AUTOPILOT_KOKORO_VOICE=af_heart
# AUTOPILOT_ESPEAK_LIB=/opt/homebrew/lib/libespeak-ng.dylib
# AUTOPILOT_SAY_VOICE=Samantha
# AUTOPILOT_PIPER_BIN=

# Set to 0 and no model touches the form: Jobright's autofill runs, the
# tailored resume and cover letter go on in code, a screenshot is taken and
# the tab is yours. 1 = the browser agent finishes the rest.
AUTOPILOT_AGENT=1
# Scout mail: new roles on a watched careers page arrive by mail. Gmail:
# 2-step verification on, an App Password from myaccount.google.com/apppasswords
# (never the account password). Other providers: set the host and port
# (587 STARTTLS, 465 SSL). AUTOPILOT_MAIL_TO defaults to the user; commas
# for several. Leave unset and the hits stay on the Scout tab only.
# AUTOPILOT_SMTP_USER=you@gmail.com
# AUTOPILOT_SMTP_PASS=xxxx xxxx xxxx xxxx
# AUTOPILOT_MAIL_TO=you@gmail.com
# AUTOPILOT_SMTP_HOST=smtp.gmail.com
# AUTOPILOT_SMTP_PORT=587
# AUTOPILOT_SCOUT=0 turns the scout thread off; the Scout tab still works by hand.
