{
  "manifest_version": 3,
  "name": "Job Autopilot Capture",
  "version": "0.3.0",
  "description": "Screens the postings you open from Jobright and queues the ones worth applying to.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "notifications",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jobright.ai/*",
        "https://*.jobright.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
