#!/bin/bash
# Start Autopilot: the server, the Autopilot Chrome, the injector, the page.
#
#   scripts/autopilot          start what is not running, open the page
#   scripts/autopilot server   the server only: no Chrome, no injector
#   scripts/autopilot stop     stop the server and the injector (never Chrome:
#                              it holds the person's logins and open forms)
#   scripts/autopilot status   what is running, on which port
#   scripts/autopilot restart  stop, then start (after an update or an edit)
#   scripts/autopilot serve    the server in the foreground, for a supervisor
#                              to own (scripts/service.sh); never for a person
#
# Autopilot.app runs this. Everything the person owns lives in
# $AUTOPILOT_HOME (default ~/Library/Application Support/Autopilot); the
# clone this script sits in is code only.

set -u
REPO="$(cd "$(dirname "$0")/.." && pwd)"
# The installed app keeps everything in Application Support. A development
# checkout has always kept its data inside the clone, and pointing that one
# at Application Support does not move the data: it hides it, and the queue
# reads empty with 123 applications still on disk. So the clone's own data
# wins when it exists and the app folder has none.
if [ -z "${AUTOPILOT_HOME:-}" ]; then
  APP_HOME="$HOME/Library/Application Support/Autopilot"
  if [ -e "$REPO/data/queue.json" ] && [ ! -e "$APP_HOME/data/queue.json" ]; then
    AUTOPILOT_HOME="$REPO"
  else
    AUTOPILOT_HOME="$APP_HOME"
  fi
fi
export AUTOPILOT_HOME
RUN="$AUTOPILOT_HOME/run"
LOGS="$AUTOPILOT_HOME/logs"
PY="$REPO/.venv/bin/python"
mkdir -p "$RUN" "$LOGS"

alive() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }
healthy() { curl -fsS -m 2 "http://127.0.0.1:$1/health" >/dev/null 2>&1; }
# The Autopilot server, and not merely something that answers /health: only
# ours also serves /setup. The board scan on 8788 answers neither.
ours() {
  [ -n "${1:-}" ] || return 1
  healthy "$1" && curl -fsS -m 2 "http://127.0.0.1:$1/setup" >/dev/null 2>&1
}

# 8787 unless something else holds it (Caveman's proxy has); the port is
# kept, so the injector and the page agree with the server.
pick_port() {
  # A server already answering is the server, whoever started it. The
  # supervised copy keeps no pid file of ours, so without this a second one
  # starts on the next free port and the two of them get a data folder each -
  # the first entry in CLAUDE.md's list of what bites you.
  local recorded; recorded="$(cat "$RUN/port" 2>/dev/null || true)"
  for p in "$recorded" 8787; do ours "$p" && { echo "$p"; return; }; done
  if [ -f "$RUN/port" ] && alive "$RUN/server.pid"; then cat "$RUN/port"; return; fi
  for p in 8787 8788 8789 8790 8791 8792 8793 8794 8795 8796; do
    if ! lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1; then echo "$p"; return; fi
  done
  echo "no free port between 8787 and 8796" >&2; exit 1
}

stop() {
  for name in inject server; do
    if alive "$RUN/$name.pid"; then kill "$(cat "$RUN/$name.pid")" 2>/dev/null; echo "stopped $name"; fi
    rm -f "$RUN/$name.pid"
  done
  # A supervised server is not ours to kill: the supervisor starts it again
  # within seconds, which is the whole point of it.
  local port; port="$(cat "$RUN/port" 2>/dev/null || echo 8787)"
  sleep 1
  if ours "$port"; then
    echo "a supervised server is still serving on $port; scripts/service.sh stop" >&2
  fi
}

serve() {
  [ -x "$PY" ] || { echo "no .venv: run scripts/install.sh first" >&2; exit 1; }
  local port; port="$(pick_port)"
  if ours "$port"; then
    echo "a server is already serving on $port; nothing to supervise" >&2
    exit 0
  fi
  echo "$port" > "$RUN/port"
  export AUTOPILOT_SERVER_URL="http://127.0.0.1:$port"
  cd "$REPO" || exit 1
  # exec, so the supervisor watches uvicorn itself and not a shell that has
  # already exited. No pid file: the supervisor owns the process.
  exec "$PY" -m uvicorn server.app:app --host 127.0.0.1 --port "$port"
}

status() {
  local port; port="$(cat "$RUN/port" 2>/dev/null || echo "?")"
  if alive "$RUN/server.pid"; then echo "server  running on $port"
  elif ours "$port"; then echo "server  running on $port (supervised, no pid file of ours)"
  else echo "server  stopped"; fi
  alive "$RUN/inject.pid" && echo "inject  running" || echo "inject  stopped"
  curl -fsS -m 2 http://127.0.0.1:9333/json/version >/dev/null 2>&1 && echo "chrome  running (9333)" || echo "chrome  stopped"
  echo "data    $AUTOPILOT_HOME"
}

start() {
  if [ ! -x "$PY" ]; then
    osascript -e 'display alert "Autopilot is not installed yet" message "Ask Claude Code to install it: see INSTALL.md in the Autopilot folder."' >/dev/null 2>&1
    echo "no .venv: run scripts/install.sh first" >&2; exit 1
  fi
  local port; port="$(pick_port)"
  echo "$port" > "$RUN/port"
  export AUTOPILOT_SERVER_URL="http://127.0.0.1:$port"
  cd "$REPO" || exit 1

  if ours "$port" && ! alive "$RUN/server.pid"; then
    echo "server already serving on $port (supervised); left alone"
  elif ! alive "$RUN/server.pid" || ! healthy "$port"; then
    nohup "$PY" -m uvicorn server.app:app --host 127.0.0.1 --port "$port" \
      >> "$LOGS/server.log" 2>&1 < /dev/null &
    echo $! > "$RUN/server.pid"
    for _ in $(seq 1 60); do healthy "$port" && break; sleep 0.5; done
    healthy "$port" || { echo "the server did not start; see $LOGS/server.log" >&2; exit 1; }
  fi

  local page="http://127.0.0.1:$port/"
  if [ "${1:-}" = "server" ]; then echo "server on $page"; return; fi
  if ! alive "$RUN/inject.pid"; then
    # The injector launches the Autopilot Chrome when it is not running and
    # opens the page in it.
    nohup "$PY" -m browser.inject --open "$page" >> "$LOGS/inject.log" 2>&1 < /dev/null &
    echo $! > "$RUN/inject.pid"
  else
    # Already running: a new tab on the page in the same Chrome.
    curl -fsS -m 3 -X PUT "http://127.0.0.1:9333/json/new?$page" >/dev/null 2>&1 || open "$page"
    osascript -e 'tell application "Google Chrome" to activate' >/dev/null 2>&1
  fi
  echo "Autopilot on $page (data in $AUTOPILOT_HOME)"
}

case "${1:-start}" in
  start) start ;;
  server) start server ;;
  serve) serve ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  status) status ;;
  *) echo "usage: $0 [start|server|serve|stop|restart|status]" >&2; exit 2 ;;
esac
